POSTGRES_DB=ainews
POSTGRES_USER=ainews
POSTGRES_PASSWORD=change_me_please
CADDY_SITE_ADDRESS=5kzt.l.time4vps.cloud

# App behavior
AINEWS_REQUEST_TIMEOUT_SECONDS=15
AINEWS_MAX_RETRIES=3
AINEWS_PER_SOURCE_MIN_INTERVAL_SECONDS=1.0
AINEWS_RESPECT_ROBOTS_TXT=true

# Maintenance
RETENTION_DAYS=100
BACKUP_RETENTION_DAYS=14
DB_MAX_SIZE_GB=5
DB_TARGET_SIZE_GB=4
DB_RETENTION_STEP_DAYS=7

# App auth (single operator)
AINEWS_AUTH_ENABLED=false
AINEWS_AUTH_USERNAME=
AINEWS_AUTH_PASSWORD_HASH=
AINEWS_AUTH_SECRET=
AINEWS_AUTH_SESSION_TTL_SECONDS=3600
AINEWS_AUTH_COOKIE_SECURE=true

# MCP auth (for agent tools)
AINEWS_MCP_AUTH_ENABLED=false
AINEWS_MCP_AUTH_TOKEN=

# Daily digest: direct DeepSeek API (key stays on the server, never in git)
DS_API_KEY=
AINEWS_DIGEST_MODEL=deepseek-flash
AINEWS_DIGEST_ALLOW_FALLBACK=1

# Mandatory AI article screening in production
JEV_API_KEY=
AINEWS_JEV_ENABLED=true
AINEWS_SEMANTIC_ADMISSION_ENABLED=true

# Weekly analytics remains disabled until explicitly re-enabled
AINEWS_WEEKLY_V2_ENABLED=false
AINEWS_WEEKLY_CRON_ENABLED=0
